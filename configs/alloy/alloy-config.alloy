loki.source.syslog "srlinux" {
  listener {
    address               = "0.0.0.0:1514"
    protocol              = "udp"
    idle_timeout          = "300s"
    label_structured_data = true
    labels                = { job = "syslog" }
  }

  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.process.srlinux.receiver]
}

loki.relabel "syslog" {
  forward_to = [loki.write.local.receiver]

  rule {
    source_labels = ["__syslog_message_hostname"]
    regex         = "(.+)"
    target_label  = "source"
  }

  rule {
    source_labels = ["__syslog_message_severity"]
    regex         = "(.+)"
    target_label  = "level"
  }

  rule {
    source_labels = ["__syslog_message_app_name"]
    regex         = "(.+)"
    target_label  = "application"
  }

  rule {
    source_labels = ["__syslog_message_facility"]
    regex         = "(.+)"
    target_label  = "facility"
  }

  rule {
    source_labels = ["__syslog_message_proc_id"]
    regex         = "(.+)"
    target_label  = "procid"
  }
}

// SR Linux writes two kinds of messages:
//   events: "chassis|3636|3636|00116|EV|portUp|N: Interface ethernet-1/3 is now up"
//   traces: "debug|8601|8707|00029|TR||W: bgpmgr  bgp_mgr_inst.cc:5268  HandleFibMgrNhResolve  vrtr_id_ 1 ..."
// Events report what happened (a port went down, a BGP session changed state,
// a commit succeeded) and get the labels kind="event" and event=<name>.
// Traces are debug output of the applications and get kind="trace"; at boot
// they come in bursts of thousands, many of them at warning level.
// The prefix moves to structured metadata, the log line keeps the message.
loki.process "srlinux" {
  forward_to = [loki.write.local.receiver]

  stage.regex {
    expression = `^\s*(?P<subsystem>[\w-]+)\|\d+\|\d+\|\d+\|(?P<kind>EV|TR)\|(?P<event>[\w-]*)\|\w: (?P<text>(?s:.*))$`
  }

  // Traces start with the module, the source location and the function.
  stage.regex {
    source     = "text"
    expression = `^(?P<module>\w+)\s+(?P<location>[\w.-]+:\d+)\s+(?P<function>\S+)\s+(?P<text>(?s:.*))$`
  }

  stage.template {
    source   = "kind"
    template = `{{ if eq .Value "EV" }}event{{ else if eq .Value "TR" }}trace{{ end }}`
  }

  stage.labels {
    values = {
      kind  = "",
      event = "",
    }
  }

  stage.structured_metadata {
    values = {
      subsystem = "",
      module    = "",
      location  = "",
      function  = "",
    }
  }

  stage.output {
    source = "text"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
